{#
Custom prototype pattern: "About these records" note.
In-context help on a catalogue record page. It explains the records in the
series this record belongs to (facts about the records, written for this
page), and links to whole guides without excerpting them.
See docs/custom-components.md

Params:
  seriesReference (string, required) - for example "PROB 1"
  seriesTitle (string, required) - the series name
  seriesHref (string) - link to the series record
  intro (string, required) - one sentence placing this record in its series
  points (array, required) - short notes, each { title, text } or { title, html }
  guides (array) - whole guides that use these records, each { text, href }
  headingLevel (number) - defaults to 2
  classes (string) - extra classes
#}
{%- from "components/catalogue-reference/macro.njk" import protoCatalogueReference -%}

{% macro protoAboutTheseRecords(params) -%}
{%- set h = params.headingLevel or 2 -%}
<div class="tna-aside tna-aside--tight tna-background-tint proto-about-these-records{% if params.classes %} {{ params.classes }}{% endif %}">
  <h{{ h }} class="tna-heading-m">About these records</h{{ h }}>
  <p>{{ params.intro }} {{ protoCatalogueReference({ reference: params.seriesReference }) }}
    {%- if params.seriesHref %}<a href="{{ params.seriesHref }}">{{ params.seriesTitle }}</a>{% else %}{{ params.seriesTitle }}{% endif %}.</p>
  <div class="tna-container tna-container--nested">
    <div class="tna-column tna-column--width-2-3 tna-column--full-small tna-column--full-tiny">
      <dl class="proto-about-these-records__points">
        {%- for point in params.points %}
        <dt class="tna-heading-s">{{ point.title }}</dt>
        <dd>{% if point.html %}{{ point.html | safe }}{% else %}{{ point.text }}{% endif %}</dd>
        {%- endfor %}
      </dl>
    </div>
    {%- if params.guides %}
    <div class="tna-column tna-column--width-1-3 tna-column--full-small tna-column--full-tiny">
      <h{{ h + 1 }} class="tna-heading-s">Guides that use these records</h{{ h + 1 }}>
      <ul class="tna-ul tna-ul--plain">
        {%- for guide in params.guides %}
        <li><a href="{{ guide.href }}">{{ guide.text }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
  </div>
</div>
{%- endmacro %}
